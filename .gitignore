webpack.stats.*

# Ignore automatically generated Markdown files
docs/components

# Explicitly include docs/public, otherwise it's
# ignored due to the rules below
!.vitepress/docs/public/
# Ignore automatically generated Vue components
.vitepress/cache/
.vitepress/docs/components/
.vitepress/docs/tokens/
.vitepress/docs/guides/
.vitepress/docs/design-tokens.md
.vitepress/docs/elements.md
.vitepress/docs/changelog.md
.vitepress/docs/index.md
.vitepress/theme/components/constants/